# ═══════════════════════════════════════════════════════════════════════
# A2Sniper 3.0 — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` (backend) or set the equivalent variables
# on Vercel (frontend) and Railway (backend). NEVER commit real secrets.

# ─── BACKEND (Railway) ─────────────────────────────────────────────────

# REQUIRED — server will refuse to start if missing or set to the
# known-compromised value that was previously hardcoded in source.
# Generate a fresh keypair with:
#   pip install py-vapid
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); \
#     v.save_key('private.pem'); v.save_public_key('public.pem')"
# then convert to URL-safe base64 (no padding) of the raw 32-byte private
# value and the 65-byte uncompressed public point.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# REQUIRED — JWT signing secret. Minimum 32 characters. Server fails fast if
# missing or too short. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# REQUIRED for production — PostgreSQL connection string.
# Falls back to local SQLite (backend/a2sniper.db) if unset.
# Railway/Supabase/Neon format:
#   postgresql://user:password@host:port/dbname?pgbouncer=true
DATABASE_URL=

# REQUIRED for transactional email (OTP, password reset, welcome).
# Get a key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@a2sniper.ai

# REQUIRED for Google OAuth (server-side code exchange).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED for Telegram bot. Empty string silently disables bot features.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@A2Sniper_BinaryTrader

# REQUIRED for admin dashboard login — the admin email address. OTPs for the
# admin 2FA flow are sent to this address via Resend. Also used by the legacy
# auto-promotion logic (any user registering with this email gets is_admin=true).
ADMIN_EMAIL=

# REQUIRED for admin dashboard login — the admin password. Verified against the
# value the user enters on /admin-dawes-stevens-2026/login (constant-time
# comparison). This is SEPARATE from any user account password. Generate a
# strong password with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# REQUIRED for admin dashboard login — JWT signing secret for the admin_token
# cookie. Must be >= 16 chars. MUST match the value set on Vercel (the edge
# middleware uses it to verify the JWT signature). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_TOKEN=

# OPTIONAL — comma-separated list of IPs allowed to access
# /admin-dawes-stevens-2026/* without 2FA (founder bypass). If set, requests
# from these IPs skip the admin login entirely.
FOUNDER_IPS=

# OPTIONAL but RECOMMENDED — encryption key for the SSID file (last_ssid.txt).
# The SSID is the user's full Pocket Option session token; it is now stored
# server-side only (never in the browser) and encrypted at rest with Fernet
# (AES-128-CBC + HMAC-SHA256). If unset, the SSID is stored as plaintext
# (with a warning) for backward compat. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SSID_ENCRYPTION_KEY=

# OPTIONAL — added to the backend CORS allow-list.
# Auto-injected by Railway.
RAILWAY_PUBLIC_DOMAIN=

# Auto-injected by Railway. Backend listens on this port.
PORT=8000


# ─── FRONTEND (Vercel) ─────────────────────────────────────────────────

# Server-side only — URL of the Railway backend. Used by the same-origin
# /api/* proxy in app/api/[[...path]]/route.ts.
API_BACKEND_URL=https://<your-railway-backend-domain>.up.railway.app

# Client-side fallback if API_BACKEND_URL is unset.
NEXT_PUBLIC_API_URL=https://<your-railway-backend-domain>.up.railway.app

# Client-side Google OAuth client ID (must match GOOGLE_CLIENT_ID on backend).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
